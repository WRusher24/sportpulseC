# ---- Database (Neon PostgreSQL). Without it the app runs on the built-in in-memory seed dataset. ----
DATABASE_URL=

# ---- Auth / encryption (generate with: openssl rand -hex 32) ----
AUTH_SECRET=

# ---- Cron protection. Vercel sends "Authorization: Bearer $CRON_SECRET" automatically when this is set. ----
CRON_SECRET=

# ---- AI engine (system fallback; users can override in /settings) ----
# AI_PROVIDER = openai | anthropic
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Live sports data (system fallback; users can override in /settings) ----
# SPORTS_PROVIDER = auto | espn | portals | api-football | sportmonks | mock
SPORTS_PROVIDER=auto
API_FOOTBALL_KEY=
API_BASKETBALL_KEY=
SPORTMONKS_TOKEN=

# ---- Optional: override RSS feed URLs per source (sport5, one, sport1, ynet, walla) ----
FEED_URL_SPORT5=
FEED_URL_ONE=
FEED_URL_SPORT1=
FEED_URL_YNET=
FEED_URL_WALLA=

# ---- Optional: skip seeding on build (default: seed only if the database is empty) ----
SKIP_DB_SEED=

# ---- Added: Google Gemini + custom OpenAI-compatible provider (AI_PROVIDER may also be gemini | custom) ----
GEMINI_API_KEY=
GEMINI_MODEL=
# Base URL of any OpenAI-compatible server (Ollama, vLLM, OpenRouter, Groq ...). Trusted: may be an internal address.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ---- Live sports data needs NO key: default "auto" = ESPN public JSON + scraping of the Israeli portals. ----
# Set to 1 to disable the refresh-on-visit background cycle (cron / GitHub Actions only).
DISABLE_LAZY_REFRESH=
